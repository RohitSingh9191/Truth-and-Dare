{
  "name": "truthspin",
  "version": "1.0.0",
  "private": true,
  "description": "Truth n Dare: play truth or dare with a spinning bottle. Free, offline, no sign-up.",
  "type": "module",
  "scripts": {
    "questions": "node scripts/build-questions.mjs && node scripts/build-pages.mjs && node scripts/build-seo.mjs",
    "dev": "npm run questions && vite",
    "build": "npm run questions && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "e2e": "playwright test",
    "images": "node scripts/make-images.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@netlify/blobs": "^11.1.5",
    "qrcode-generator": "^2.0.4"
  }
}
